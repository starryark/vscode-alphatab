{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "alphaTex",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
        {
            "include": "#comment"
        },
        {
            "include": "#number"
        }
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.alphatab",
				"match": "\\\\[a-zA-Z]+"
			}]
		},
		"strings": {
			"name": "string.quoted.double.alphatab",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.alphatab",
					"match": "\\\\."
				}
			]
		},
        "comment": {
            "patterns": [
                {
                    "begin": "(^[ \\t]+)?(?=//)",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.whitespace.comment.leading.alphatab"
                        }
                    },
                    "end": "(?!\\G)",
                    "patterns": [
                        {
                            "begin": "//",
                            "beginCaptures": {
                                "0": {
                                    "name": "punctuation.definition.comment.alphatab"
                                }
                            },
                            "end": "\\n",
                            "name": "comment.line.double-slash.alphatab"
                        }
                    ]
                },
                {
                    "begin": "/\\*",
                    "end": "\\*/",
                    "name": "comment.block.c-style.alphatab"
                }
            ]
        },
        "number": {
            "comment": "Order matters: the longest token must be tried first, or the bare-integer rule swallows the fret of a fret.string pair. NOTE the escaping — in JSON, \"\\\\.\" is the regex \\. (a literal dot); \"\\\\\\\\.\" would be a backslash followed by any character, which is what this rule used to say and why fret.string notation was never highlighted.",
            "patterns": [
                {
                    "comment": "fret.string.duration, e.g. 12.2.8",
                    "name": "constant.numeric.tab.alphatab",
                    "match": "\\b[0-9]+\\.[0-9]+\\.[0-9]+"
                },
                {
                    "comment": "fret.string, e.g. 12.2 — the most common token in a guitar tab",
                    "name": "constant.numeric.tab.alphatab",
                    "match": "\\b[0-9]+\\.[0-9]+"
                },
                {
                    "name": "constant.numeric.alphatab",
                    "match": "\\b[0-9]+"
                }
            ]
        }
	},
	"scopeName": "source.alphatab"
}