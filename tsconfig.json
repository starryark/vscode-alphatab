{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		// 故意不给 DOM：扩展宿主跑在 Node 进程里，没有 document/window。
		// webview 侧有自己的 webview/tsconfig.json，那份才带 DOM。
		"lib": [
			"ES2020"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true, /* enable all strict type-checking options */
		"skipLibCheck": true,
		"noImplicitReturns": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"webview",
		"out",
		"dist"
	]
}
