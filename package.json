{
    "name": "alphatab",
    "displayName": "alphatab",
    "description": "use alpha tex to write guitar tab",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.85.0"
    },
    "author": {
        "name": "kirigaya"
    },
    "publisher": "kirigaya",
    "icon": "image/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/starryark/vscode-alphatab.git"
    },
    "categories": [
        "Programming Languages",
        "Visualization",
        "Education"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "alphatab.preview",
                "title": "%alphatab.preview%",
                "category": "alphaTab",
                "icon": "$(open-preview)"
            },
            {
                "command": "alphatab.playPause",
                "title": "%alphatab.playPause%",
                "category": "alphaTab"
            },
            {
                "command": "alphatab.stop",
                "title": "%alphatab.stop%",
                "category": "alphaTab"
            },
            {
                "command": "alphatab.toggleAB",
                "title": "%alphatab.toggleAB%",
                "category": "alphaTab"
            },
            {
                "command": "alphatab.toggleLoop",
                "title": "%alphatab.toggleLoop%",
                "category": "alphaTab"
            },
            {
                "command": "alphatab.runGate",
                "title": "%alphatab.runGate%",
                "category": "alphaTab",
                "icon": "$(checklist)"
            },
            {
                "command": "alphatab.snapshot",
                "title": "%alphatab.snapshot%",
                "category": "alphaTab"
            },
            {
                "command": "alphatab.importSoundFont",
                "title": "Import SoundFont (导入音色库)",
                "category": "alphaTab"
            },
            {
                "command": "alphatab.print",
                "title": "Print to PDF (打印)",
                "category": "alphaTab"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "when": "editorLangId == alphatab",
                    "command": "alphatab.preview",
                    "group": "navigation@1"
                }
            ],
            "commandPalette": [
                {
                    "command": "alphatab.playPause",
                    "when": "editorLangId == alphatab || activeWebviewPanelId == alphatab.preview"
                },
                {
                    "command": "alphatab.stop",
                    "when": "editorLangId == alphatab || activeWebviewPanelId == alphatab.preview"
                },
                {
                    "command": "alphatab.toggleAB",
                    "when": "editorLangId == alphatab || activeWebviewPanelId == alphatab.preview"
                },
                {
                    "command": "alphatab.toggleLoop",
                    "when": "editorLangId == alphatab || activeWebviewPanelId == alphatab.preview"
                }
            ]
        },
        "keybindings": [
            {
                "command": "alphatab.playPause",
                "key": "alt+space",
                "when": "editorLangId == alphatab || activeWebviewPanelId == alphatab.preview"
            },
            {
                "command": "alphatab.toggleAB",
                "key": "alt+b",
                "when": "editorLangId == alphatab || activeWebviewPanelId == alphatab.preview"
            },
            {
                "command": "alphatab.toggleLoop",
                "key": "alt+l",
                "when": "editorLangId == alphatab || activeWebviewPanelId == alphatab.preview"
            }
        ],
        "configuration": {
            "title": "alphaTab",
            "properties": {
                "alphatab.staveProfile": {
                    "type": "string",
                    "enum": [
                        "default",
                        "scoretab",
                        "score",
                        "tab",
                        "tabmixed"
                    ],
                    "default": "default",
                    "description": "%alphatab.config.staveProfile%"
                },
                "alphatab.layoutMode": {
                    "type": "string",
                    "enum": [
                        "page",
                        "horizontal"
                    ],
                    "default": "page",
                    "description": "%alphatab.config.layoutMode%"
                },
                "alphatab.scale": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0.25,
                    "maximum": 4,
                    "description": "%alphatab.config.scale%"
                },
                "alphatab.soundFonts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "%alphatab.config.soundFonts%"
                },
                "alphatab.defaultSoundFont": {
                    "type": "string",
                    "default": "",
                    "description": "%alphatab.config.defaultSoundFont%"
                },
                "alphatab.masterVolume": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "%alphatab.config.masterVolume%"
                },
                "alphatab.player.outputMode": {
                    "type": "string",
                    "enum": [
                        "scriptProcessor",
                        "audioWorklet"
                    ],
                    "default": "scriptProcessor",
                    "description": "%alphatab.config.outputMode%"
                },
                "alphatab.renderDebounceMs": {
                    "type": "number",
                    "default": 150,
                    "minimum": 0,
                    "maximum": 2000,
                    "description": "%alphatab.config.renderDebounceMs%"
                },
                "alphatab.ab.partner": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "cover.alphatab",
                        "source.alphatab"
                    ],
                    "description": "%alphatab.config.abPartner%"
                },
                "alphatab.companion.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%alphatab.config.companionEnabled%"
                },
                "alphatab.companion.preset": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "none",
                        "piano-to-guitar"
                    ],
                    "default": "auto",
                    "description": "%alphatab.config.companionPreset%"
                },
                "alphatab.companion.runOn": {
                    "type": "string",
                    "enum": [
                        "save",
                        "manual"
                    ],
                    "default": "save",
                    "description": "%alphatab.config.companionRunOn%"
                },
                "alphatab.companion.transpose": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "default": null,
                    "description": "%alphatab.config.companionTranspose%"
                },
                "alphatab.companion.gain": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "high",
                        "crunch",
                        "clean",
                        null
                    ],
                    "default": null,
                    "description": "%alphatab.config.companionGain%"
                },
                "alphatab.companion.warningsAsErrors": {
                    "type": "boolean",
                    "default": false,
                    "description": "%alphatab.config.companionWarningsAsErrors%"
                },
                "alphatab.companion.snapOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "%alphatab.config.companionSnapOnSave%"
                },
                "alphatab.syncCursor": {
                    "type": "boolean",
                    "default": true,
                    "description": "%alphatab.config.syncCursor%"
                }
            }
        },
        "languages": [
            {
                "id": "alphatab",
                "aliases": [
                    "alphaTex",
                    "alphatab"
                ],
                "extensions": [
                    ".alphatab",
                    ".atex"
                ],
                "icon": {
                    "dark": "icon/guitar.dark.svg",
                    "light": "icon/guitar.light.svg"
                },
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "alphatab",
                "scopeName": "source.alphatab",
                "path": "./syntaxes/alphatab.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "alphatab",
                "path": "./snippets/alphatab.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "sync:vendor": "node scripts/sync-vendor.mjs",
        "check:vendor": "node scripts/sync-vendor.mjs --check",
        "pretest": "npm run check:vendor && npm run compile-tests && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "mocha out/test/**/*.test.js"
    },
    "devDependencies": {
        "@types/glob": "^8.0.0",
        "@types/mocha": "^10.0.0",
        "@types/node": "16.x",
        "@types/vscode": "^1.85.0",
        "@typescript-eslint/eslint-plugin": "^5.42.0",
        "@typescript-eslint/parser": "^5.42.0",
        "@vscode/test-electron": "^2.2.0",
        "eslint": "^8.26.0",
        "glob": "^8.0.3",
        "mocha": "^10.1.0",
        "ts-loader": "^9.4.1",
        "typescript": "^4.8.4",
        "webpack": "^5.74.0",
        "webpack-cli": "^4.10.0"
    },
    "dependencies": {
        "@coderline/alphatab": "^1.8.4"
    }
}
